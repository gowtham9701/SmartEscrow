APP_NAME=SmartEscrow
ENV=local
DATABASE_URL=postgresql+asyncpg://smartescrow:smartescrow@localhost:5432/smartescrow

JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Razorpay India payment gateway keys — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=whsec_replace_me
PAYMENT_CURRENCY=INR
PAYMENT_PROVIDER=razorpay

GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GITHUB_APP_TOKEN=ghp_replace_me

# Local Ollama orchestration (Apple Silicon, zero cloud inference cost)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

INTEGRITY_STAKE_INR_PAISA=2500
