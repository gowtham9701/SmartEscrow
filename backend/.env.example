# ============================================================================
# SmartEscrow — Backend environment variables
# Copy to `.env` for local dev, or set these in your host (e.g. Render).
# ============================================================================

APP_NAME=SmartEscrow
ENV=local                       # local | production

# --- Database (PostgreSQL / Neon) -----------------------------------------
# The marketplace now persists to PostgreSQL in just TWO tables (users,
# operations). Point this at your Neon database (or any Postgres). Keep the
# `+asyncpg` suffix — the marketplace layer strips it for its own driver while
# the legacy milestone modules need it.
#   Local dev:   postgresql+asyncpg://postgres@localhost:5432/smartescrow
#   Neon (prod): postgresql+asyncpg://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres@localhost:5432/smartescrow

# --- Auth / JWT -----------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Email / OTP delivery (see docs/SMTP_CREDENTIALS_GUIDE.md) -------------
# Leave SMTP_* blank to run in demo mode (OTP shown on screen).
# Fill them in to send REAL verification emails (free via Gmail/Brevo/Resend).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SmartEscrow <no-reply@smartescrow.io>
SMTP_USE_TLS=true
# Optional HTTP email API (works even where SMTP ports are blocked). Free 3k/mo.
RESEND_API_KEY=
OTP_DELIVERY=auto               # auto | email | demo
OTP_TTL_MINUTES=15

# --- Payments (MVP uses a simulated gateway; see docs/PRODUCTION_GUIDE.md) -
PAYMENT_PROVIDER=mock           # mock | stripe | razorpay
PAYMENT_CURRENCY=USD
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=whsec_replace_me

# --- GitHub (AI verification + webhook merge triggers) --------------------
GITHUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GITHUB_APP_TOKEN=ghp_replace_me

# --- Local Ollama LLM (optional, zero cloud cost) -------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

INTEGRITY_STAKE_INR_PAISA=2500
